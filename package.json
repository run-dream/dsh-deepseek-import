{
  "name": "dsh-deepseek-account-import",
  "version": "0.1.3",
  "description": "Migrate a whole DeepSeek account (every conversation, with thinking, web-search evidence, images and attachments) into DeepSeek Harness sessions via dsh-chat-import interchange v1.",
  "type": "module",
  "main": "./lib/index.mjs",
  "bin": {
    "ds-migrate": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./convert": {
      "default": "./lib/convert.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "skill",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "deepseek",
    "deepseek-web",
    "chat-import",
    "migration",
    "bulk"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/run-dream/dsh-deepseek-import.git"
  },
  "homepage": "https://github.com/run-dream/dsh-deepseek-import#readme",
  "bugs": {
    "url": "https://github.com/run-dream/dsh-deepseek-import/issues"
  },
  "author": "run-dream",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
