{
  "name": "dsh-deepseek-import",
  "version": "0.1.0",
  "description": "Migrate a whole DeepSeek web/app account (sessions, thinking, images, attachments) into DeepSeek Harness sessions via dsh-chat-import interchange v1.",
  "type": "module",
  "main": "./lib/index.mjs",
  "bin": { "ds-migrate": "./bin/cli.mjs" },
  "exports": {
    ".": { "default": "./lib/index.mjs" },
    "./convert": { "default": "./lib/convert.mjs" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "bin", "skill", "cordis.patch.yml", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "keywords": ["deepseek-harness", "dsh-plugin", "dsh", "deepseek", "chat-import", "migration"],
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
